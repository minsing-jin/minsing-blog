{
  "name": "minsing-blog",
  "type": "module",
  "version": "6.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist && cp -r dist/pagefind public/",
    "preview": "astro preview",
    "sync": "astro sync",
    "obsidian:sync": "node scripts/sync-obsidian-posts.mjs",
    "obsidian:dry-run": "node scripts/sync-obsidian-posts.mjs --dry-run",
    "obsidian:publish": "node scripts/publish-obsidian-posts.mjs",
    "obsidian:publish:deploy": "node scripts/publish-obsidian-posts.mjs --deploy",
    "obsidian:watch": "node scripts/watch-obsidian-posts.mjs",
    "obsidian:watch:deploy": "node scripts/watch-obsidian-posts.mjs --deploy",
    "obsidian:install-auto": "node scripts/install-obsidian-auto-update.mjs",
    "hermes:list": "node scripts/hermes-publish.mjs list",
    "hermes:draft": "node scripts/hermes-publish.mjs draft",
    "hermes:approve": "node scripts/hermes-publish.mjs approve",
    "hermes:reject": "node scripts/hermes-publish.mjs reject",
    "hermes:publish": "node scripts/hermes-publish.mjs publish",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.1",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.4.2",
    "dayjs": "^1.11.21",
    "lodash.kebabcase": "^4.1.1",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.26.0",
    "sharp": "^0.34.5",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.2.0",
    "@pagefind/default-ui": "^1.5.2",
    "@shikijs/transformers": "^4.1.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/lodash.kebabcase": "^4.1.9",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.1",
    "eslint-plugin-astro": "^1.7.0",
    "pagefind": "^1.5.2",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3"
  }
}
