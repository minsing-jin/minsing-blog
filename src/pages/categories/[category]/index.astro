---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import { getUniqueCategories } from "@/utils/getUniqueCategories";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getKoreanPosts } from "@/utils/localizedPosts";
import { tplStr, useTranslations } from "@/i18n";
import config from "@/config";
import { getImportedCategory } from "@/utils/categories";
import {
  getProgrammingSeries,
  PROGRAMMING_CATEGORY,
} from "@/utils/programmingSeries";

export const getStaticPaths = (async () => {
  const posts = getKoreanPosts(
    await getCollection("posts", ({ data }) => !data.draft)
  );
  const categories = getUniqueCategories(posts);

  return categories.map(category => ({
    params: { category: category.category },
    props: {
      categoryDescription: category.description,
      categoryName: category.categoryName,
      posts: getSortedPosts(
        posts.filter(
          post =>
            post.data.category === category.categoryName ||
            post.data.velogSeries?.some(
              series => getImportedCategory(series) === category.categoryName
            )
        )
      ),
    },
  }));
}) satisfies GetStaticPaths;

const { categoryDescription, categoryName, posts } = Astro.props;
const series =
  categoryName === PROGRAMMING_CATEGORY ? getProgrammingSeries(posts) : [];

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${categoryName} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle={categoryName}
    pageDesc={tplStr(t.pages.categoryDesc, { category: categoryName })}
  >
    <p class="text-muted-foreground mb-6">{categoryDescription}</p>
    {
      series.length > 0 && (
        <section aria-labelledby="series-heading" class="mb-10">
          <h2 id="series-heading" class="mb-4 text-xl font-bold">
            Velog 시리즈
          </h2>
          <ul class="grid gap-3 sm:grid-cols-2">
            {series.map(group => (
              <li>
                <a
                  class="border-border hover:border-accent block rounded-xl border p-4"
                  href={`/categories/programming-and-cs/${group.slug}/`}
                >
                  <span class="text-accent font-semibold">{group.name}</span>
                  <span class="text-muted-foreground ml-2 text-sm">
                    {group.posts.length}개 글
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    {series.length > 0 && <h2 class="mb-4 text-xl font-bold">전체 글</h2>}
    {
      posts.length > 0 ? (
        <ul>
          {posts.map(data => (
            <Card {...data} />
          ))}
        </ul>
      ) : (
        <p class="text-muted-foreground">{t.pages.categoryEmpty}</p>
      )
    }
  </Main>

  <Footer />
</Layout>
