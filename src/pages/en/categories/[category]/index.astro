---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getUniqueCategories } from "@/utils/getUniqueCategories";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getEnglishOrKoreanPosts } from "@/utils/localizedPosts";
import config from "@/config";
import { getImportedCategory } from "@/utils/categories";

export const getStaticPaths = (async () => {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const categories = getUniqueCategories(posts);

  return categories.map(category => ({
    params: { category: category.category },
    props: {
      categoryDescription: category.description,
      categoryName: category.categoryName,
      posts: getSortedPosts(
        getEnglishOrKoreanPosts(
          posts.filter(
            post =>
              post.data.category === category.categoryName ||
              post.data.velogSeries?.some(
                series => getImportedCategory(series) === category.categoryName
              )
          )
        )
      ),
    },
  }));
}) satisfies GetStaticPaths;

const { categoryDescription, categoryName, posts } = Astro.props;
---

<Layout title={`${categoryName} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle={categoryName}
    pageDesc={`All posts in ${categoryName}. Korean originals are linked until English translations are approved.`}
  >
    <p class="text-muted-foreground mb-6">{categoryDescription}</p>
    {
      posts.length > 0 ? (
        <ul>
          {posts.map(post => (
            <Card {...post} />
          ))}
        </ul>
      ) : (
        <p class="text-muted-foreground">
          No public posts in this category yet.
        </p>
      )
    }
  </Main>
  <Footer />
</Layout>
