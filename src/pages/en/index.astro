---
import { getCollection } from "astro:content";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import CategoryPill from "@/components/CategoryPill.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const posts = getSortedPosts(await getCollection("posts"));
const recentPosts = posts.slice(0, config.posts.perIndex);
---

<Layout
  title={`Minsing Log in English | ${config.site.title}`}
  description="An English entry point for Minsing Jin's public building, AI, open source, and founder notes."
>
  <Header />
  <main id="main-content" class="app-layout">
    <section class="border-border border-b pt-10 pb-8">
      <p class="text-accent text-sm font-semibold tracking-widest uppercase">
        English Edition
      </p>
      <h1 class="mt-3 mb-5 text-4xl leading-tight font-bold sm:text-5xl">
        I document what I build, learn, and ship.
      </h1>
      <p class="text-muted-foreground max-w-prose text-lg">
        This is the English entry point for my public notes on AI agents, build
        logs, open source, product experiments, and founder learning.
      </p>
      <p class="text-muted-foreground mt-3 max-w-prose">
        Full English post translations will be published through the same
        approval workflow as Korean posts. Until then, post links point to the
        Korean originals.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <Socials />
        <LinkButton href="/categories/">
          Browse categories
          <IconArrowRight class="inline-block" />
        </LinkButton>
      </div>
    </section>

    <section class="pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
      <ul>
        {
          recentPosts.map(post => (
            <li class="my-6">
              <CategoryPill category={post.data.category} size="sm" />
              <a
                href={getPostUrl(post.id, post.filePath, "ko")}
                class="text-accent mt-2 inline-block text-lg font-medium underline-offset-4 hover:underline"
              >
                {post.data.title}
              </a>
              <p class="text-muted-foreground">{post.data.description}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
