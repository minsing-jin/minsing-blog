---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getEnglishOrKoreanPosts } from "@/utils/localizedPosts";
import config from "@/config";

const posts = getSortedPosts(
  getEnglishOrKoreanPosts(await getCollection("posts"))
);
---

<Layout
  title={`Posts | ${config.site.title}`}
  description="All public posts in English."
>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle="Posts"
    pageDesc="English editions of every public post."
  >
    <ul>
      {posts.map(post => <Card {...post} />)}
    </ul>
  </Main>
  <Footer />
</Layout>
