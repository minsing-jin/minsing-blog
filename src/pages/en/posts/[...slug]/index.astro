---
import { type CollectionEntry, getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import Tag from "@/components/Tag.astro";
import CategoryPill from "@/components/CategoryPill.astro";
import { getEnglishPosts, getEnglishRouteSlug } from "@/utils/localizedPosts";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyStr } from "@/utils/slugify";
import { toTransitionName } from "@/utils/toTransitionName";
import EditPost from "../../../posts/[...slug]/_components/EditPost.astro";
import ShareLinks from "../../../posts/[...slug]/_components/ShareLinks.astro";
import BackButton from "../../../posts/[...slug]/_components/BackButton.astro";
import BackToTopButton from "../../../posts/[...slug]/_components/BackToTopButton.astro";
import AdjacentPostNav from "../../../posts/[...slug]/_components/AdjacentPostNav.astro";
import AdSlot from "@/components/AdSlot.astro";
import NewsletterCta from "@/components/NewsletterCta.astro";
import config from "@/config";

export const getStaticPaths = (async () => {
  const posts = getSortedPosts(getEnglishPosts(await getCollection("posts")));

  return posts.map((post, index) => ({
    params: { slug: getEnglishRouteSlug(post) },
    props: {
      post,
      prevPost:
        index > 0
          ? {
              id: posts[index - 1].id,
              title: posts[index - 1].data.title,
              filePath: posts[index - 1].filePath,
            }
          : null,
      nextPost:
        index < posts.length - 1
          ? {
              id: posts[index + 1].id,
              title: posts[index + 1].data.title,
              filePath: posts[index + 1].filePath,
            }
          : null,
    },
  }));
}) satisfies GetStaticPaths;

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  post: CollectionEntry<"posts">;
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { post, prevPost, nextPost } = Astro.props;
const {
  title,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  category,
  tags,
  summary,
  concepts,
  related,
  status,
  hideEditPost,
} = post.data;

const { Content } = await render(post);
const hasWikiMeta =
  Boolean(summary) ||
  concepts.length > 0 ||
  related.length > 0 ||
  Boolean(status);
const getRelatedHref = (item: string) => {
  if (/^https?:\/\//i.test(item) || item.startsWith("/")) return item;
  return `/en/posts/${slugifyStr(item)}/`;
};

let ogImageUrl: string | undefined;

if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage;
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src;
}

if (!ogImageUrl && config.features.dynamicOgImage) ogImageUrl = "/og.png";

const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  description={description}
  ogImage={ogImage}
  canonicalURL={canonicalURL}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
>
  <Header />

  <BackButton />

  <main
    id="main-content"
    class:list={["app-layout", { "mt-8": !config.features.showBackButton }]}
    data-pagefind-body
  >
    <p class="text-accent mb-3 text-sm font-semibold tracking-widest uppercase">
      English Edition
    </p>
    <h1
      style={{ viewTransitionName: toTransitionName(title) }}
      class="text-accent inline-block text-3xl font-bold sm:text-4xl"
    >
      {title}
    </h1>

    <div class="my-2 flex items-center gap-2">
      <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
      <span
        aria-hidden="true"
        class:list={[
          "text-muted-foreground max-sm:hidden",
          { hidden: !config.features.editPost?.enabled || hideEditPost },
        ]}
      >
        |
      </span>
      <EditPost {hideEditPost} {post} class="max-sm:hidden" />
    </div>

    <div class="mt-4">
      <CategoryPill {category} />
    </div>

    {
      hasWikiMeta && (
        <aside class="border-accent/40 bg-muted/30 mt-6 rounded-2xl border border-dashed p-5 text-sm">
          <div class="mb-3 flex flex-wrap items-center gap-2">
            <span class="bg-accent text-background rounded-full px-3 py-1 text-xs font-semibold">
              LLM wiki
            </span>
            {status && (
              <span class="border-accent/40 text-muted-foreground rounded-full border px-3 py-1 text-xs">
                status: {status}
              </span>
            )}
          </div>
          {summary && <p class="text-foreground mb-4 text-base">{summary}</p>}
          {concepts.length > 0 && (
            <div class="mb-3">
              <p class="text-foreground mb-2 font-semibold">Concepts</p>
              <ul class="flex flex-wrap gap-2">
                {concepts.map(concept => (
                  <li class="bg-background text-muted-foreground rounded-full px-3 py-1">
                    {concept}
                  </li>
                ))}
              </ul>
            </div>
          )}
          {related.length > 0 && (
            <div>
              <p class="text-foreground mb-2 font-semibold">Related posts</p>
              <ul class="flex flex-wrap gap-2">
                {related.map(item => (
                  <li>
                    <a
                      class="bg-background text-accent rounded-full px-3 py-1 underline-offset-4 hover:underline"
                      href={getRelatedHref(item)}
                    >
                      {item}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </aside>
      )
    }

    <article
      id="article"
      class:list={[
        "mt-8 w-full",
        "app-prose max-w-app",
        "prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)",
      ]}
    >
      <Content />
    </article>

    <NewsletterCta compact />

    <AdSlot label="Ad" />

    <hr class="my-8 border-dashed" />

    <EditPost class="sm:hidden" {hideEditPost} {post} />

    <BackToTopButton />

    <ul class="mt-4 mb-8 flex flex-wrap gap-4 sm:my-8">
      {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
    </ul>

    <ShareLinks />

    <hr class="my-8 border-dashed" />

    <AdjacentPostNav {prevPost} {nextPost} />
  </main>
  <Footer />
</PostLayout>
