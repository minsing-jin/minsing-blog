---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import NewsletterCta from "@/components/NewsletterCta.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const pageDescription =
  locale === "en"
    ? "What Minsing is building and learning right now."
    : "진민성이 지금 만들고 배우는 것들입니다.";
---

<Layout title={`Now | ${config.site.title}`} description={pageDescription}>
  <Header />
  <Breadcrumb />
  <Main pageTitle="Now" class="app-prose">
    {
      locale === "en" ? (
        <>
          <p>
            This page tracks the projects, learning loops, and public notes I am
            focused on right now.
          </p>
          <h2>Current Focus</h2>
          <ul>
            <li>Building useful products faster with software and AI agents</li>
            <li>
              Operating this blog as a public learning and branding system
            </li>
            <li>Turning what I learn into writing, code, and small products</li>
          </ul>
          <h2>This Month's Writing Themes</h2>
          <ul>
            <li>How the blog publishing system is being built</li>
            <li>Weekly build logs and automation notes</li>
            <li>Reasons for readers to come back before monetization</li>
          </ul>
          <h2>Update Principle</h2>
          <p>
            I document intermediate decisions and failures, not only finished
            outcomes. I aim to update this page at least once a month.
          </p>
        </>
      ) : (
        <>
          <p>
            이 페이지는 제가 지금 집중하고 있는 프로젝트, 학습 주제, 공개적으로
            남길 기록을 정리하는 곳입니다.
          </p>
          <h2>지금 집중하는 것</h2>
          <ul>
            <li>개발과 AI를 활용해 실제 제품을 빠르게 만드는 실험</li>
            <li>공개적으로 기록하면서 독자와 팬을 만드는 블로그 운영</li>
            <li>배운 것을 글, 코드, 작은 제품으로 전환하는 루틴 만들기</li>
          </ul>
          <h2>이번 달 기록 주제</h2>
          <ul>
            <li>블로그를 처음 배포하고 검색 노출을 준비한 과정</li>
            <li>매주 한 번 이상 빌드 로그 작성</li>
            <li>AdSense보다 먼저 독자가 다시 돌아올 이유 만들기</li>
          </ul>
          <h2>업데이트 원칙</h2>
          <p>
            완성된 결과만이 아니라 중간 판단과 실패를 기록합니다. 이 페이지는 한
            달에 한 번 이상 갱신합니다.
          </p>
        </>
      )
    }
    <NewsletterCta compact />
  </Main>
  <Footer />
</Layout>
