---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import AdSlot from "@/components/AdSlot.astro";
import NewsletterCta from "@/components/NewsletterCta.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
const hero =
  locale === "en"
    ? {
        eyebrow: "Build in Public",
        title: "I document what I build and learn.",
        description:
          "This blog is a public record of shipping software, exploring AI agents, building products, and learning in the open.",
        intro: "If this is your first visit, start with",
        introLink: "why I started writing in public",
      }
    : {
        eyebrow: "Build in Public",
        title: "만들고 배우는 과정을 공개합니다.",
        description:
          "완성된 성공담보다 실제 여정을 기록합니다. 개발, AI, 제품 만들기, 창업, 학습을 하며 무엇을 시도했고 어디서 막혔고 무엇을 바꿨는지 남깁니다.",
        intro: "처음 오셨다면",
        introLink: "왜 공개적으로 기록하는지",
      };
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="border-border border-b pt-10 pb-8">
      <p class="text-accent text-sm font-semibold tracking-widest uppercase">
        {hero.eyebrow}
      </p>
      <h1
        class="mt-3 mb-5 text-4xl leading-tight font-bold sm:mb-6 sm:text-5xl"
      >
        {hero.title}
      </h1>
      <p class="text-muted-foreground max-w-prose text-lg">
        {hero.description}
      </p>
      <p class="mt-3">
        {hero.intro}
        <LinkButton
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          href={getRelativeLocaleUrl(locale, "posts/start-public-journey")}
        >
          {hero.introLink}
        </LinkButton>
        {locale === "en" ? "." : "부터 읽어보세요."}
      </p>
      <div class="mt-6 flex max-sm:flex-col sm:items-center">
        {
          socials.length > 0 && (
            <>
              <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
                {t.home.socialLinks}:
              </div>
              <Socials />
            </>
          )
        }
        <a
          target="_blank"
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="inline-flex items-center p-2"
          aria-label="RSS Feed"
          title="RSS Feed"
        >
          <IconRss
            width={20}
            height={20}
            class="stroke-accent stroke-3 rtl:-rotate-90"
          />
          <span class="sr-only">RSS Feed</span>
        </a>
      </div>
    </section>

    <NewsletterCta />

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <AdSlot label={locale === "en" ? "Sponsor or ad" : "스폰서 또는 광고"} />

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
