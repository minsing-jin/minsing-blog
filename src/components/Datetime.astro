---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import config from "@/config";
import { useTranslations } from "@/i18n";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  class?: string;
  size?: "sm" | "lg";
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
};

const {
  pubDatetime,
  modDatetime,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
} = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(Astro.currentLocale);

const tz = postTimezone ?? config.site.timezone;
const published = dayjs(pubDatetime).tz(tz);
const updated = modDatetime ? dayjs(modDatetime).tz(tz) : null;
// Same-day re-syncs are not meaningful revisions for readers.
const isModified = updated && updated.isAfter(published, "day");

const datePattern = locale.startsWith("ko") ? "YYYY년 M월 D일" : "D MMM, YYYY";
---

<div
  class:list={[
    "text-muted-foreground flex flex-wrap items-center gap-x-2",
    className,
  ]}
>
  <IconCalendar
    class:list={[
      "inline-block size-6 min-w-5.5",
      { "scale-90": size === "sm" },
    ]}
  />
  <time
    class:list={["text-sm", { "sm:text-base": size === "lg" }]}
    datetime={published.toISOString()}
  >
    {published.format(datePattern)}
  </time>
  {
    isModified && size === "lg" && (
      <span class="text-sm opacity-80 sm:text-base">
        · {t.post.updatedAt}{" "}
        <time datetime={updated.toISOString()}>{updated.format(datePattern)}</time>
      </span>
    )
  }
</div>
