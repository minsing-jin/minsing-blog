---
type Props = {
  label?: string;
};

const { label = "광고" } = Astro.props;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const adsenseSlot = import.meta.env.PUBLIC_ADSENSE_SLOT;
---

{
  adsenseClient && adsenseSlot ? (
    <aside class="not-prose my-8">
      <p class="text-muted-foreground mb-2 text-xs">{label}</p>
      <ins
        class="adsbygoogle block"
        style="display:block"
        data-ad-client={adsenseClient}
        data-ad-slot={adsenseSlot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </aside>
  ) : (
    <aside class="border-border not-prose text-muted-foreground my-8 rounded-xl border border-dashed p-4 text-sm">
      AdSense 승인 후 Cloudflare Pages 환경변수
      <code>PUBLIC_ADSENSE_CLIENT</code>와 <code>PUBLIC_ADSENSE_SLOT</code>를
      넣으면 이 영역이 광고 슬롯으로 바뀝니다.
    </aside>
  )
}
