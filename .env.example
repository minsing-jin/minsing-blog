PUBLIC_NEWSLETTER_ACTION=
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT=
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Comments (Giscus + GitHub Discussions). These public values are safe to expose.
# The repository and Q&A category are already configured by default.
PUBLIC_GISCUS_ENABLED=true
PUBLIC_GISCUS_REPO=minsing-jin/minsing-blog
PUBLIC_GISCUS_REPO_ID=R_kgDOSxI_9g
PUBLIC_GISCUS_CATEGORY=Q&A
PUBLIC_GISCUS_CATEGORY_ID=DIC_kwDOSxI_9s4DHfhn

# Obsidian publishing
# Point this at the Obsidian folder that contains notes intended for the blog.
# Only notes with `publish: true` are synced by default.
OBSIDIAN_POSTS_DIR=/Users/your-name/Documents/Obsidian\ Vault/SecondBrain/Blog
OBSIDIAN_REQUIRE_PUBLISH=1
OBSIDIAN_PUBLISH_FIELD=publish
OBSIDIAN_PUBLISH_VALUE=true

# Optional auto-publish behavior
OBSIDIAN_COMMIT_MESSAGE="Publish Obsidian posts"
OBSIDIAN_WATCH_INTERVAL_MS=5000
OBSIDIAN_WATCH_DEBOUNCE_MS=3000

# Optional Discord/Hermes bridge values. Keep real tokens in local .env only.
HERMES_DISCORD_BOT_TOKEN=
HERMES_DISCORD_GUILD_ID=
HERMES_DISCORD_APPROVER_IDS=
